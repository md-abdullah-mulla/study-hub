# Vercel deploy must not carry your personal study data or local build junk
data/
node_modules/
client/node_modules/
server/node_modules/
client/dist/
client/dist-vercel/
.git/
*.db
*.db-wal
*.db-shm

# The desktop app is not part of the web deployment — it ships through GitHub
# Releases. Without this the CLI tries to upload release/ (hundreds of MB) and
# gets killed before the build even starts.
desktop/
client/dist-desktop/
