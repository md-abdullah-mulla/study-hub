# ---------------------------------------------------------------------------
# Copy to `.env` (server reads plain env vars; Docker/Render set them directly)
# ---------------------------------------------------------------------------

# Port the API/web server listens on
PORT=4000

# Where the SQLite database file lives.
# On a host with a persistent disk, point this inside that disk, e.g. /data/study.db
DB_FILE=../data/study.db

# Allowed browser origin for the API (comma separated) when the UI runs on a
# different host than the API. Leave empty for same-origin / local development.
# CORS_ORIGIN=https://your-app.onrender.com

# --- frontend build-time variable (client/.env) ---------------------------
# Local dev: leave empty (Vite proxies /api to the server).
# Split hosting (UI on one host, API on another): set the API base URL,
# e.g. VITE_API_URL=https://study-hub-api.onrender.com
# VITE_API_URL=
